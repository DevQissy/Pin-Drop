    <string name="help_dialog_title">Help Guide</string>
    <string name="help_section_about_title">About Pin Drop</string>
    <string name="help_section_about_content">This tool downloads images, videos, and albums from Pinterest platform, fetching your desired content in the highest available quality.</string>
    <string name="help_section_steps_title">Download Steps</string>
    <string name="help_section_steps_content">1. Copy the pin or album link from the Pinterest app.\n2. Tap the ＋ icon in the bottom bar.\n3. Paste the copied link into the input field.\n4. Press the start button to begin downloading.</string>
    <string name="help_section_storage_title">File Storage Location</string>
    <string name="help_section_storage_content">Downloaded files are automatically saved to your device storage and visible in the gallery:\n• Videos: Movies/PinDrop folder\n• Images: Pictures/PinDrop folder</string>
    <string name="help_section_albums_title">Downloading Albums</string>
    <string name="help_section_albums_content">When you enter an album link, the app intelligently detects all images in it and downloads them all at once.</string>
    <string name="help_section_history_title">Download History</string>
    <string name="help_section_history_content">All downloaded files are recorded in the history section for quick access in the future.</string>
    <string name="help_section_quality_title">File Quality</string>
    <string name="help_section_quality_content">Pin Drop downloads files with no additional compression, preserving the original quality as available on Pinterest servers.</string>
    <string name="help_dialog_notice">Note: If you encounter any issues with the app, please report the problem through the \"Support\" section.</string>
